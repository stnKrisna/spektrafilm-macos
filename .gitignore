# macOS

.DS_Store
.AppleDouble
.LSOverride

# Xcode

DerivedData/
build/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/

# Swift Package Manager

.build/
.swiftpm/
Package.resolved

# Generated by the MetalKernelSourcePlugin build tool from
# Sources/SpektrafilmCore/Shaders/SpektrafilmKernels.metal (canonical source).
# SwiftPM emits it under .build/; an Xcode build phase may emit it in-tree.

MetalKernelSource.generated.swift

# Xcode previews / caches

*.xccheckout
*.xcscmblueprint

# Archives / exports

*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Temporary files

*.tmp
*.temp
*.log
*.swp
*.swo
*~

# Local environment / config

.env
.env.*
!.env.example

# Generated Spektrafilm resources
# Keep the manifest, scripts, and directory structure in Git,
# but avoid committing downloaded upstream profile/LUT data.

Resources/Spektrafilm/Profiles/Film/*.json
Resources/Spektrafilm/Profiles/Print/*.json
Resources/Spektrafilm/pack.json
Resources/Spektrafilm/spectra_lut.f32
Resources/Spektrafilm/LICENSE-SPEKTRAFILM-DATA.txt

# If resources live under the app target instead:

Sources/SpektrafilmApp/Resources/Spektrafilm/Profiles/Film/*.json
Sources/SpektrafilmApp/Resources/Spektrafilm/Profiles/Print/*.json
Sources/SpektrafilmApp/Resources/Spektrafilm/pack.json
Sources/SpektrafilmApp/Resources/Spektrafilm/spectra_lut.f32
Sources/SpektrafilmApp/Resources/Spektrafilm/LICENSE-SPEKTRAFILM-DATA.txt

# Current Swift-port Data layout used by Scripts/fetch-data.sh

Data/profiles/*.json
Data/pack.json
Data/spectra_lut.f32
Data/SPEKTRAFILM_DATA_LICENSE.txt
Data/SPEKTRAFILM_DATA_CHANGELOG.txt
Data/INSTALL.json

# Preserve empty profile directories

!Resources/Spektrafilm/Profiles/Film/.gitkeep
!Resources/Spektrafilm/Profiles/Print/.gitkeep
!Sources/SpektrafilmApp/Resources/Spektrafilm/Profiles/Film/.gitkeep
!Sources/SpektrafilmApp/Resources/Spektrafilm/Profiles/Print/.gitkeep
!Data/profiles/.gitkeep
